# Example .env.feature for the feature profile (Docker + AWS + Google OAuth)
#
# COPY THIS FILE:
#   cp .env.feature.example .env.feature
#
# THEN FILL IN THE VALUES BELOW with your actual AWS credentials and Google OAuth secrets
# (see docs/feature-profile-setup.md for detailed setup instructions)
#
# IMPORTANT: .env.feature is gitignored — it will never be committed to git
#            Keep it secure; never share or publish it

# ──────────────────────────────────────────────────────────────────────
# AWS S3 (Image Storage)
# ──────────────────────────────────────────────────────────────────────
# Get these from: AWS IAM → Users → imagegallery-app → Security credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=wJalr...

# Get this from: S3 → Bucket name (e.g., imagegallery-yourname)
S3_BUCKET_NAME=imagegallery-yourname

# ──────────────────────────────────────────────────────────────────────
# AWS RDS PostgreSQL (Database)
# ──────────────────────────────────────────────────────────────────────
# Get these from: RDS → Databases → imagegallery → Connectivity & security
DB_HOST=imagegallery.c9akciq32.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=imagegallery

# Get these from: RDS creation (master username + password)
DB_USERNAME=postgres
DB_PASSWORD=your-strong-rds-password

# ──────────────────────────────────────────────────────────────────────
# Google OAuth2 (Sign in with Google)
# ──────────────────────────────────────────────────────────────────────
# Get these from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnop

# ──────────────────────────────────────────────────────────────────────
# Application Configuration
# ──────────────────────────────────────────────────────────────────────
# Frontend URL (used for OAuth2 redirects and CORS)
GALLERY_FRONTEND_URL=http://localhost:3000

# Initial admin account (provisioned at startup)
GALLERY_ADMIN_EMAIL=admin@example.com
GALLERY_ADMIN_PASSWORD=changeme

# Optional: Anthropic API key for visual image descriptions (leave blank to disable)
ANTHROPIC_API_KEY=
