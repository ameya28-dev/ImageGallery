# Copy to .env (gitignored) and fill in as needed.
# Auto-loaded by `docker compose up` from the project root.

# Enables AI image description on upload + natural-language search.
# Leave blank to disable — the app runs fine without it.
# Get your key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional overrides (all have safe built-in defaults) ----
# GALLERY_ADMIN_EMAIL=admin@example.com
# GALLERY_ADMIN_PASSWORD=changeme
# GALLERY_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS10aGlzLWluLXByb2Q=
